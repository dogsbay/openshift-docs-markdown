---
import { tv } from "tailwind-variants";

const avatar = tv({
  base: "relative inline-flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-full bg-muted",
});

const avatarImage = tv({
  base: "aspect-square h-full w-full object-cover",
});

const avatarFallback = tv({
  base: "flex h-full w-full items-center justify-center rounded-full bg-muted text-sm font-semibold text-muted-foreground",
});

interface Props {
  src?: string;
  alt?: string;
  fallback?: string;
  class?: string;
  [key: string]: unknown;
}
const { src, alt = "", fallback, class: className, ...rest } = Astro.props;

const initials =
  fallback ||
  alt
    .split(" ")
    .map((w) => w[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();
// The name is on the avatar itself, so it is read whether the image loads, fails or was never given:
// the initials stand in visually only, and a failed image is hidden with its alt.
// An author's own aria-label wins (an empty one does not); the role is ours, as in render-html.
const label = alt ? { role: "img", "aria-label": (rest["aria-label"] as string | undefined) || alt } : {};
---

<span class={avatar({ class: className })} {...rest} {...label}>
  {
    src ? (
      <>
        <img
          class={avatarImage()}
          src={src}
          alt=""
          width="40"
          height="40"
          onerror="this.hidden=true;this.nextElementSibling.hidden=false"
        />
        <span class={avatarFallback()} aria-hidden="true" hidden>
          {initials}
        </span>
      </>
    ) : (
      <span class={avatarFallback()} aria-hidden="true">
        {initials}
      </span>
    )
  }
</span>
