---
import { tv } from "tailwind-variants";

const tableContainer = tv({
  base: "relative w-full overflow-x-auto",
});

const table = tv({
  base: "w-full caption-top text-sm",
});

interface Props {
  class?: string;
  /**
   * Optional table caption, rendered as a `<caption>`: the table's title,
   * above it and left-aligned.
   * For a caption with markup, use the `caption` slot instead.
   */
  caption?: string;
  [key: string]: unknown;
}

const { class: className, caption, ...rest } = Astro.props;

// A table's caption is its title: above the table, left-aligned, in the body color
const captionClass = "mb-2 text-left text-sm font-medium text-foreground";
---

<div class={tableContainer()}>
  <table class={table({ class: className })} {...rest}>
    {Astro.slots.has("caption") ? (
      <caption class={captionClass}><slot name="caption" /></caption>
    ) : (
      caption && <caption class={captionClass}>{caption}</caption>
    )}
    <slot />
  </table>
</div>
