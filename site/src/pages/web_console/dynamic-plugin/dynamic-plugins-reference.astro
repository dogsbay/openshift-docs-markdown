      <h3 id="_consoleactiongroup" class="group scroll-mt-20"><code>console.action/group</code><a href="#_consoleactiongroup" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
