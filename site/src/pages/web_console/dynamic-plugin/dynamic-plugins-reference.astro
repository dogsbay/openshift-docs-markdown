      <TableCell>Name</TableCell>
      <TableCell>Value Type</TableCell>
      <TableCell>Optional</TableCell>
      <TableCell>Description</TableCell>
      </TableRow>
      <TableRow>
      <TableCell><code>contextId</code></TableCell>
      <TableCell><code>string</code></TableCell>
      <TableCell>no</TableCell>
      <TableCell>The context ID helps to narrow the scope of contributed actions to a particular area of the application. Examples include <code>topology</code> and <code>helm</code>.</TableCell>
      </TableRow>
      <TableRow>
      <TableCell><code>filter</code></TableCell>
      <TableCell><code>CodeRef&lt;(scope: any, action: Action) =&gt; boolean&gt;</code></TableCell>
