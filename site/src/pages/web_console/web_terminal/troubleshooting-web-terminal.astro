      <CodeBlock code={"apiVersion: networking.k8s.io/v1\nkind: NetworkPolicy\nmetadata:\n  name: allow-from-openshift-operators\nspec:\n  ingress:\n  - from:\n    - namespaceSelector:\n        matchLabels:\n          kubernetes.io/metadata.name: openshift-operators\n  podSelector: {}\n  policyTypes:\n  - Ingress"} lang="yaml" title="Allowing ingress from the openshift-operators namespace" />
