        <AlertTitle>Note</AlertTitle>
        <AlertDescription>
          <p>Set the <code>spec.outputs.kafka.url</code> field to the URL of the Kafka server where the logs are forwarded to.</p>
        </AlertDescription>
      </Alert>
      <p><Fragment set:html={"<a name=\"ztp-clusterlogns-yaml\">"} /><Fragment set:html={"</a>"} /></p>
      <CodeBlock code={"{% include \"./snippets/ztp_ClusterLogNS.yaml\" %}"} lang="yaml" title="Recommended ClusterLogNS.yaml" />
      <p><Fragment set:html={"<a name=\"ztp-clusterlogopergroup-yaml\">"} /><Fragment set:html={"</a>"} /></p>
      <CodeBlock code={"{% include \"./snippets/ztp_ClusterLogOperGroup.yaml\" %}"} lang="yaml" title="Recommended ClusterLogOperGroup.yaml" />
      <p><Fragment set:html={"<a name=\"ztp-clusterlogserviceaccount-yaml\">"} /><Fragment set:html={"</a>"} /></p>
      <CodeBlock code={"{% include \"./snippets/ztp_ClusterLogServiceAccount.yaml\" %}"} lang="yaml" title="Recommended ClusterLogServiceAccount.yaml" />
      <p><Fragment set:html={"<a name=\"ztp-clusterlogserviceaccountauditbinding-yaml\">"} /><Fragment set:html={"</a>"} /></p>
      <CodeBlock code={"{% include \"./snippets/ztp_ClusterLogServiceAccountAuditBinding.yaml\" %}"} lang="yaml" title="Recommended ClusterLogServiceAccountAuditBinding.yaml" />
      <p><Fragment set:html={"<a name=\"ztp-clusterlogserviceaccountinfrastructurebinding-yaml\">"} /><Fragment set:html={"</a>"} /></p>
