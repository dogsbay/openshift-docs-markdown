      </TableRow>
      <TableRow>
      <TableCell>Local Storage Operator <Fragment set:html={"<sup>"} />[1]<Fragment set:html={"</sup>"} /></TableCell>
      <TableCell>4.14</TableCell>
      <TableCell>Yes</TableCell>
      </TableRow>
      <TableRow>
      <TableCell>Logical Volume Manager (LVM) Storage <Fragment set:html={"<sup>"} />[1]<Fragment set:html={"</sup>"} /></TableCell>
