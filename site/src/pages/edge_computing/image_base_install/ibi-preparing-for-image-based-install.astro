      <CodeBlock code={"apiVersion: operators.coreos.com/v1alpha1\nkind: Subscription\nmetadata:\n  name: openshift-lifecycle-agent-subscription\n  namespace: openshift-lifecycle-agent\nspec:\n  channel: \"stable\"\n  name: lifecycle-agent\n  source: redhat-operators\n  sourceNamespace: openshift-marketplace"} lang="yaml" />
