>\n</tr>\n<tr>\n  <td>CIFS/SMB</td>\n  <td></td>\n  <td></td>\n  <td>✅</td>\n  <td></td>\n  <td></td>\n  <td></td>\n</tr>\n<tr>\n  <td>VMware vSphere</td>\n  <td>✅<sup>[5]</sup></td>\n  <td></td>\n  <td></td>\n  <td>✅<sup>[6]</sup></td>\n  <td></td>\n  <td>✅<sup>[7]</sup></td>\n</tr>\n</tbody>\n</table>\n1.\n"} />
