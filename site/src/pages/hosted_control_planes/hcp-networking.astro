      <TableRow>
      <TableCell><code>443</code></TableCell>
      <TableCell>TCP</TableCell>
      <TableCell>HTTPS</TableCell>
      <TableCell>Container registries, <code>Ignition</code> or <code>Konnectivity</code> service via <code>Route</code> service publishing strategy, external HTTPS services</TableCell>
      <TableCell>Always</TableCell>
      </TableRow>
      <TableRow>
