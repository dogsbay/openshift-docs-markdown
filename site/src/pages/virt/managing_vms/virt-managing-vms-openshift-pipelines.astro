      <TableCell><code>modify-vm-template</code></TableCell>
      <TableCell>Modify a virtual machine template.</TableCell>
      </TableRow>
      <TableRow>
      <TableCell><code>modify-data-object</code></TableCell>
      <TableCell>Create or delete data volumes or data sources.</TableCell>
      </TableRow>
