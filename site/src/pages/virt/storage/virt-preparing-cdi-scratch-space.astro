      <p class="_abstract">This matrix shows the supported CDI operations for content types against endpoints, and which of these operations requires scratch space.</p>
      <Fragment set:html={"<table>\n<thead>\n<tr>\n  <th>Content types</th>\n  <th>HTTP</th>\n  <th>HTTPS</th>\n  <th>Basic HTTP authentication</th>\n  <th>Registry</th>\n  <th>Upload</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n  <td>KubeVirt (QCOW2)</td>\n  <td>&#10003; QCOW2<br><br>&#10003; GZ*<br><br>&#10003; XZ*</td>\n  <td>&#10003; QCOW2**<br><br>&#10003; GZ*<br><br>&#10003; XZ*</td>\n  <td>&#10003; QCOW2<br><br>&#10003; GZ*<br><br>&#10003; XZ*</td>\n  <td>&#10003; QCOW2*<br><br>&#9633; GZ<br><br>&#9633; XZ</td>\n  <td>&#10003; QCOW2*<br><br>&#10003; GZ*<br><br>&#10003; XZ*</td>\n</tr>\n<tr>\n  <td>KubeVirt (raw)</td>\n  <td>&#10003; raw<br><br>&#10003; GZ<br><br>&#10003; XZ</td>\n  <td>&#10003; raw<br><br>&#10003; GZ<br><br>&#10003; XZ</td>\n  <td>&#10003; raw<br><br>&#10003; GZ<br><br>&#10003; XZ</td>\n  <td>&#10003; raw*<br><br>&#9633; GZ<br><br>&#9633; XZ</td>\n  <td>&#10003; raw*<br><br>&#10003; GZ*<br><br>&#10003; XZ*</td>\n</tr>\n</tbody>\n</table>\n"} />
