      <TableBody>
      <TableRow>
      <TableCell><code>LiveMigrate</code> ^1^</TableCell>
      <TableCell>Prioritizes workload continuity over upgrades.</TableCell>
      <TableCell>No</TableCell>
      <TableCell>Yes ^2^</TableCell>
      </TableRow>
      <TableRow>
      <TableCell><code>LiveMigrateIfPossible</code></TableCell>
      <TableCell>Prioritizes upgrades over workload continuity to ensure that the environment is updated.</TableCell>
      <TableCell>Yes</TableCell>
      <TableCell>No</TableCell>
      </TableRow>
      <TableRow>
      <TableCell><code>None</code> ^3^</TableCell>
