      <CodeBlock code={"$ oc get pvc -n openshift-compliance rhcos4-moderate-worker"} lang="terminal" />
      <CodeBlock code={"NAME                 \tSTATUS   VOLUME                                 \tCAPACITY   ACCESS MODES   STORAGECLASS   AGE\nrhcos4-moderate-worker   Bound\tpvc-548f6cfe-164b-42fe-ba13-a07cfbc77f3a   1Gi    \tRWO        \tgp2        \t92m"} lang="terminal" title="Example output" />
