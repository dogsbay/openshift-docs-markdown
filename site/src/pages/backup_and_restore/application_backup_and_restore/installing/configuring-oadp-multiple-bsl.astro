      <CodeBlock code={"apiVersion: oadp.openshift.io/v1alpha1\nkind: DataProtectionApplication\n#...\nbackupLocations:\n  - name: aws\n    velero:\n      provider: aws\n      default: true\n      objectStorage:\n        bucket: <bucket_name>\n        prefix: <prefix>\n      config:\n        region: <region_name>\n        profile: \"default\"\n      credential:\n        key: cloud\n        name: cloud-credentials\n  - name: odf\n    velero:\n      provider: aws\n      default: false\n      objectStorage:\n        bucket: <bucket_name>\n        prefix: <prefix>\n      config:\n        profile: \"default\"\n        region: <region_name>\n        s3Url: <url>\n        insecureSkipTLSVerify: \"true\"\n        s3ForcePathStyle: \"true\"\n      credential:\n        key: cloud\n        name: <custom_secret_name_odf>\n#..."} lang="yaml" title="Example DPA" />
      <p>where:</p>
