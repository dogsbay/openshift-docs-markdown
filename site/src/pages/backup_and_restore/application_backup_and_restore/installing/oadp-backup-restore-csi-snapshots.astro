      <CodeBlock code={"$ oc get datauploads -A"} lang="terminal" />
      <CodeBlock code={"NAMESPACE       NAME                  STATUS      STARTED   BYTES DONE   TOTAL BYTES   STORAGE LOCATION   AGE     NODE\nopenshift-adp   backup-test-1-sw76b   Completed   9m47s     108104082    108104082     dpa-sample-1       9m47s   ip-10-0-150-57.us-west-2.compute.internal\nopenshift-adp   mongo-block-7dtpf     Completed   14m       1073741824   1073741824    dpa-sample-1       14m     ip-10-0-150-57.us-west-2.compute.internal"} lang="terminal" title="Example output" />
      </li>
      <li>
      Check the value of the <code>status.phase</code> field of the specific <code>DataUpload</code> object by running the following command:
      <CodeBlock code={"$ oc get datauploads <dataupload_name> -o yaml"} lang="terminal" />
      <CodeBlock code={"apiVersion: velero.io/v2alpha1\nkind: DataUpload\nmetadata:\n  name: backup-test-1-sw76b\n  namespace: openshift-adp\nspec:\n  backupStorageLocation: dpa-sample-1\n  csiSnapshot:\n    snapshotClass: \"\"\n    storageClass: gp3-csi\n    volumeSnapshot: velero-mysql-fq8sl\n  operationTimeout: 10m0s\n  snapshotType: CSI\n  sourceNamespace: mysql-persistent\n  sourcePVC: mysql\nstatus:\n  completionTimestamp: \"2023-11-02T16:57:02Z\"\n  node: ip-10-0-150-57.us-west-2.compute.internal\n  path: /host_pods/15116bac-cc01-4d9b-8ee7-609c3bef6bde/volumes/kubernetes.io~csi/pvc-eead8167-556b-461a-b3ec-441749e291c4/mount\n  phase: Completed\n  progress:\n    bytesDone: 108104082\n    totalBytes: 108104082\n  snapshotID: 8da1c5febf25225f4577ada2aeb9f899\n  startTimestamp: \"2023-11-02T16:56:22Z\""} lang="yaml" title="Example output" />
