      <TableHead>Description</TableHead>
      </TableRow>
      </TableHeader>
      <TableBody>
      <TableRow>
      <TableCell><code>--details</code></TableCell>
      <TableCell>Specifies whether to display additional details in the output.</TableCell>
      </TableRow>
      </TableBody>
      </Table>
      <h3 id="oadp-cli-admin-restores-logs_oadp-cli-plugin" class="group scroll-mt-20">Restore logs command<a href="#oadp-cli-admin-restores-logs_oadp-cli-plugin" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
      <p>To view the logs for a restore, use the following command:</p>
      <CodeBlock code={"$ oc oadp restore logs <restore_name>"} lang="terminal" />
      <h3 id="oadp-cli-admin-restores-delete_oadp-cli-plugin" class="group scroll-mt-20">Restore deletion command<a href="#oadp-cli-admin-restores-delete_oadp-cli-plugin" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
