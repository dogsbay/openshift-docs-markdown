      <CodeBlock code={"apiVersion: oadp.openshift.io/vialpha1\nkind: DataProtectionApplication\n...\nspec:\n  configuration:\n    velero:\n      featureFlags:\n      - EnableAPIGroupVersions"} lang="yaml" />
      </li>
      </ul>
