      <CodeBlock code={"$ oc -n openshift-machine-api \\\n  -o jsonpath='{.spec.template.machines_v1beta1_machine_openshift_io.spec.providerSpec.value.disks[0].image}{\"\\n\"}' \\\n  get ControlPlaneMachineSet/cluster"} lang="terminal" />
      </dd>
