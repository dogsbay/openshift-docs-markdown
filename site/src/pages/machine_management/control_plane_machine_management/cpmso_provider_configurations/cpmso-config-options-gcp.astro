      <CodeBlock code={"apiVersion: machine.openshift.io/v1\nkind: ControlPlaneMachineSet\nmetadata:\n  name: cluster\n  namespace: openshift-machine-api\nspec:\n## ...\n  template:\n## ...\n      spec:\n        providerSpec:\n          value:\n            apiVersion: machine.openshift.io/v1beta1\n            canIPForward: false\n            credentialsSecret:\n              name: gcp-cloud-credentials\n            deletionProtection: false\n            disks:\n            - autoDelete: true\n              boot: true\n              image: <path_to_image>\n              labels: null\n              sizeGb: 200\n              type: pd-ssd\n            kind: GCPMachineProviderSpec\n            machineType: e2-standard-4\n            metadata:\n              creationTimestamp: null\n            metadataServiceOptions: {}\n            networkInterfaces:\n            - network: <cluster_id>-network\n              subnetwork: <cluster_id>-master-subnet\n            projectID: <project_name>\n            region: <region>\n            serviceAccounts:\n            - email: <cluster_id>-m@<project_name>.iam.gserviceaccount.com\n              scopes:\n              - https://www.googleapis.com/auth/cloud-platform\n            shieldedInstanceConfig: {}\n            tags:\n            - <cluster_id>-master\n            targetPools:\n            - <cluster_id>-api\n            userDataSecret:\n              name: master-user-data\n            zone: \"\""} lang="yaml" title="Sample Google Cloud providerSpec values" />
