      <CodeBlock code={"apiVersion: infrastructure.cluster.x-k8s.io/v1beta1\nkind: OpenStackMachineTemplate\nmetadata:\n  name: <template_name>\n  namespace: openshift-cluster-api\nspec:\n  template:\n    spec:\n      flavor: <openstack_node_machine_flavor>\n      image:\n        filter:\n          name: <openstack_image>"} lang="yaml" />
