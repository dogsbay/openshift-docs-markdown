      <CodeBlock code={"apiVersion: networking.olm.openshift.io/v1\nkind: AWSLoadBalancerController\nmetadata:\n  name: cluster\nspec:\n  subnetTagging: Auto\n  ingressClass: single-lb"} lang="yaml" />
