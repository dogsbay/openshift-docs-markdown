      <CodeBlock code={"$ oc patch network.operator cluster -p '{\n  \"spec\": {\n    \"defaultNetwork\": {\n      \"ovnKubernetesConfig\": {\n        \"routeAdvertisements\": \"Disabled\"\n      }\n    }\n  }\n}'"} lang="terminal" />
      </li>
      </ul>
