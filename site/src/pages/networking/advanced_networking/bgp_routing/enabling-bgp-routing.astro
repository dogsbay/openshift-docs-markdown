      <CodeBlock code={"$ oc patch Network.operator.openshift.io/cluster --type=merge -p '{\n  \"spec\": {\n    \"additionalRoutingCapabilities\": {\n      \"providers\": [\"FRR\"]\n    }\n  }\n}'"} lang="terminal" />
      </li>
      </ul>
