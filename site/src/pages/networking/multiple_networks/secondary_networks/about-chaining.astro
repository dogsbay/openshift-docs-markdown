      <CodeBlock code={"apiVersion: k8s.cni.cncf.io/v1\nkind: NetworkAttachmentDefinition\nmetadata:\n  name: sip-net\n  namespace: chain-example\nspec:\n  config: '{\n    \"cniVersion\": \"1.0.0\",\n    \"name\": \"sip-net\",\n    \"plugins\": [\n      {\n        \"type\": \"macvlan\",\n        \"master\": \"br-ex\",\n        \"vlan\": 200,\n        \"mode\": \"bridge\",\n        \"ipam\": {\n          \"type\": \"static\",\n          \"addresses\": [\n            {\n              \"address\": \"192.168.200.10/24\",\n              \"gateway\": \"192.168.200.1\"\n            }\n          ]\n        }\n      },\n      {\n        \"type\": \"route-override\",\n        \"addroutes\": [\n          {\n            \"dst\": \"172.16.0.0/12\",\n            \"gw\": \"192.168.200.1\"\n          }\n        ]\n      }\n    ]\n  }'"} lang="yaml" />
