      <h4 id="_copy_route_labels" class="group scroll-mt-20">Copy route labels<a href="#_copy_route_labels" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h4>
