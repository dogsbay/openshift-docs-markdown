      <h2 id="_api_endpoints" class="group scroll-mt-20">API endpoints<a href="#_api_endpoints" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h2>
      <p>The following API endpoints are available:</p>
      <ul>
      <li>
      <code>/apis/machine.openshift.io/v1beta1/machinesets</code>
      <ul><li><code>GET</code>: list objects of kind MachineSet</li></ul>
      </li>
      <li>
      <code>/apis/machine.openshift.io/v1beta1/namespaces/{"{"}{"{"} namespace {"}"}{"}"}/machinesets</code>
      <ul>
      <li><code>DELETE</code>: delete collection of MachineSet</li>
      <li><code>GET</code>: list objects of kind MachineSet</li>
      <li><code>POST</code>: create a MachineSet</li>
      </ul>
      </li>
      <li>
      <code>/apis/machine.openshift.io/v1beta1/namespaces/{"{"}{"{"} namespace {"}"}{"}"}/machinesets/{"{"}{"{"} name {"}"}{"}"}</code>
      <ul>
      <li><code>DELETE</code>: delete a MachineSet</li>
      <li><code>GET</code>: read the specified MachineSet</li>
      <li><code>PATCH</code>: partially update the specified MachineSet</li>
      <li><code>PUT</code>: replace the specified MachineSet</li>
