      <h3 id="_imagepullsecrets" class="group scroll-mt-20">.imagePullSecrets<a href="#_imagepullsecrets" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
