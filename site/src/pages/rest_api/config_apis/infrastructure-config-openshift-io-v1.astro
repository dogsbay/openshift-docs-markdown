      <h3 id="_specplatformspecpowervsserviceendpoints" class="group scroll-mt-20">.spec.platformSpec.powervs.serviceEndpoints<a href="#_specplatformspecpowervsserviceendpoints" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
