      <h3 id="_statusplatformstatusbaremetal" class="group scroll-mt-20">.status.platformStatus.baremetal<a href="#_statusplatformstatusbaremetal" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
      <dl class="my-4 space-y-2">
      <dt class="font-semibold">Description</dt>
      <dd class="ml-6 text-muted-foreground"><p>baremetal contains settings specific to the BareMetal platform.</p></dd>
      <dt class="font-semibold">Type</dt>
      <dd class="ml-6 text-muted-foreground"><CodeBlock code={"`object`"} lang="plaintext" /></dd>
      </dl>
