      <h3 id="_specoidcprovidersoidcclientsclientsecret" class="group scroll-mt-20">.spec.oidcProviders[].oidcClients[].clientSecret<a href="#_specoidcprovidersoidcclientsclientsecret" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
