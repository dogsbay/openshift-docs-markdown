      <h3 id="_specgatherconfigstoragepersistentvolumeclaim" class="group scroll-mt-20">.spec.gatherConfig.storage.persistentVolume.claim<a href="#_specgatherconfigstoragepersistentvolumeclaim" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
