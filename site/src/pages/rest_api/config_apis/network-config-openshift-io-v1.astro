      <dd class="ml-6 text-muted-foreground"><CodeBlock code={"`DELETE`"} lang="plaintext" /></dd>
      <dt class="font-semibold">Description</dt>
      <dd class="ml-6 text-muted-foreground"><CodeBlock code={"delete collection of Network"} lang="plaintext" /></dd>
      </dl>
      <p><strong>HTTP responses</strong></p>
