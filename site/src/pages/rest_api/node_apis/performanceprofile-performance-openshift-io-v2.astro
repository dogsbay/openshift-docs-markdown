      <h3 id="_spechugepagespages" class="group scroll-mt-20">.spec.hugepages.pages<a href="#_spechugepagespages" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
      <dl class="my-4 space-y-2">
      <dt class="font-semibold">Description</dt>
