      </TableRow>
      </TableHeader>
      <TableBody>
      <TableRow>
      <TableCell><code>count</code></TableCell>
      <TableCell><code>integer</code></TableCell>
      <TableCell>Count defines amount of huge pages, maps to the 'hugepages' kernel boot parameter.</TableCell>
      </TableRow>
      <TableRow>
      <TableCell><code>node</code></TableCell>
      <TableCell><code>integer</code></TableCell>
      <TableCell>Node defines the NUMA node where hugepages will be allocated, if not specified, pages will be allocated equally between NUMA nodes</TableCell>
      </TableRow>
      <TableRow>
      <TableCell><code>size</code></TableCell>
      <TableCell><code>string</code></TableCell>
      <TableCell>Size defines huge page size, maps to the 'hugepagesz' kernel boot parameter.</TableCell>
      </TableRow>
      </TableBody>
