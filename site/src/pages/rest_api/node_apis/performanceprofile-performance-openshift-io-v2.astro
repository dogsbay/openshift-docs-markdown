      </TableRow>
      </TableHeader>
      <TableBody>
      <TableRow>
      <TableCell><code>defaultHugepagesSize</code></TableCell>
      <TableCell><code>string</code></TableCell>
      <TableCell>DefaultHugePagesSize defines huge pages default size under kernel boot parameters.</TableCell>
      </TableRow>
      <TableRow>
      <TableCell><code>pages</code></TableCell>
      <TableCell><code>array</code></TableCell>
      <TableCell>Pages defines huge pages that we want to allocate at boot time.</TableCell>
      </TableRow>
