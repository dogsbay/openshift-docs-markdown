      <TableCell><code>operand</code></TableCell>
      <TableCell><code>object</code></TableCell>
      <TableCell>Optional operand configuration.</TableCell>
      </TableRow>
      <TableRow>
      <TableCell><code>priority</code></TableCell>
      <TableCell><code>integer</code></TableCell>
      <TableCell>Tuned profile priority. Highest priority is 0.</TableCell>
      </TableRow>
      <TableRow>
      <TableCell><code>profile</code></TableCell>
      <TableCell><code>string</code></TableCell>
      <TableCell>Name of the Tuned profile to recommend.</TableCell>
