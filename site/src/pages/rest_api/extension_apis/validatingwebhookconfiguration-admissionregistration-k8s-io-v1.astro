      <dd class="ml-6 text-muted-foreground"><CodeBlock code={"`array`"} lang="plaintext" /></dd>
      </dl>
      <h3 id="_webhooksrules" class="group scroll-mt-20">.webhooks[].rules[]<a href="#_webhooksrules" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
