essclass_networkingk8siov1","text":"IngressClass [networking.k8s.io/v1]"},{"depth":2,"slug":"_ipaddress_networkingk8siov1","text":"IPAddress [networking.k8s.io/v1]"},{"depth":2,"slug":"_ipamclaim_k8scnicncfiov1alpha1","text":"IPAMClaim [k8s.cni.cncf.io/v1alpha1]"},{"depth":2,"slug":"_ippool_whereaboutscnicncfiov1alpha1","text":"IPPool [whereabouts.cni.cncf.io/v1alpha1]"},{"depth":2,"slug":"_multinetworkpolicy_k8scnicncfiov1beta1","text":"MultiNetworkPolicy [k8s.cni.cncf.io/v1beta1]"},{"depth":2,"slug":"_networkattachmentdefinition_k8scnicncfiov1","text":"NetworkAttachmentDefinition [k8s.cni.cncf.io/v1]"},{"depth":2,"slug":"_networkpolicy_networkingk8siov1","text":"NetworkPolicy [networking.k8s.io/v1]"},{"depth":2,"slug":"_nodeslicepool_whereaboutscnicncfiov1alpha1","text":"NodeSlicePool [whereabouts.cni.cncf.io/v1alpha1]"},{"depth":2,"slug":"_overlappingrangeipreservation_whereaboutscnicncfiov1alpha1","text":"OverlappingRangeIPReservation [whereabouts.cni.cncf.io/v1alpha1]"},{"depth":2,"slug":"_podnetworkconnectivitycheck_controlplaneoperatoropenshiftiov1alpha1","text":"PodNetworkConnectivityCheck [controlplane.operator.openshift.io/v1alpha1]"},{"depth":2,"slug":"_referencegrant_gatewaynetworkingk8siov1beta1","text":"ReferenceGrant [gateway.networking.k8s.io/v1beta1]"},{"depth":2,"slug":"_route_routeopenshiftiov1","text":"Route [route.openshift.io/v1]"},{"depth":2,"slug":"_service_v1","text":"Service [v1]"},{"depth":2,"slug":"_servicecidr_networkingk8siov1","text":"ServiceCIDR [networking.k8s.io/v1]"},{"depth":2,"slug":"_ipaddressclaim_ipamclusterx-k8siov1beta1","text":"IPAddressClaim [ipam.cluster.x-k8s.io/v1beta1]"},{"depth":2,"slug":"_userdefinednetwork_k8sovnorgv1","text":"UserDefinedNetwork [k8s.ovn.org/v1]"}];
