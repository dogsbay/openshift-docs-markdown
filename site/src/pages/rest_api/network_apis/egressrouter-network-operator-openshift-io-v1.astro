      <h3 id="_specredirect" class="group scroll-mt-20">.spec.redirect<a href="#_specredirect" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
