      <h3 id="_specingress" class="group scroll-mt-20">.spec.ingress<a href="#_specingress" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
