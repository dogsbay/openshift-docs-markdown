      <h3 id="_specproxyendpoint" class="group scroll-mt-20">.spec.proxy[].endpoint<a href="#_specproxyendpoint" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
