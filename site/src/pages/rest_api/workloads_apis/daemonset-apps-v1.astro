      <TableCell><code>conditions[]</code></TableCell>
      <TableCell><code>object</code></TableCell>
      <TableCell>DaemonSetCondition describes the state of a DaemonSet at a certain point.</TableCell>
      </TableRow>
      <TableRow>
      <TableCell><code>currentNumberScheduled</code></TableCell>
      <TableCell><code>integer</code></TableCell>
      <TableCell>The number of nodes that are running at least 1 daemon pod and are supposed to run the daemon pod. More info: https://kubernetes.io/docs/concepts/workloads/controllers/daemonset/</TableCell>
      </TableRow>
      <TableRow>
      <TableCell><code>desiredNumberScheduled</code></TableCell>
      <TableCell><code>integer</code></TableCell>
