      <h3 id="_statusconditions" class="group scroll-mt-20">.status.conditions<a href="#_statusconditions" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
