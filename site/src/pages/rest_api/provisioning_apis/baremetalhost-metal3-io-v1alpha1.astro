      <dl class="my-4 space-y-2">
      <dt class="font-semibold">Description</dt>
      <dd class="ml-6 text-muted-foreground"><p>Condition contains details for one aspect of the current state of this API Resource.</p></dd>
      <dt class="font-semibold">Type</dt>
      <dd class="ml-6 text-muted-foreground"><CodeBlock code={"`object`"} lang="plaintext" /></dd>
      <dt class="font-semibold">Required</dt>
      <dd class="ml-6 text-muted-foreground">
      <ul>
      <li><code>lastTransitionTime</code></li>
      <li><code>message</code></li>
      <li><code>reason</code></li>
      <li><code>status</code></li>
      <li><code>type</code></li>
      </ul>
      </dd>
      </dl>
      <Table class="my-4">
      <TableHeader>
      <TableRow>
      <TableHead>Property</TableHead>
      <TableHead>Type</TableHead>
      <TableHead>Description</TableHead>
