      </TableRow>
      <TableRow>
      <TableCell><code>scheme</code></TableCell>
      <TableCell><code>string</code></TableCell>
      <TableCell>scheme defines the HTTP scheme to use when sending alerts.</TableCell>
      </TableRow>
      <TableRow>
      <TableCell><code>sigv4</code></TableCell>
