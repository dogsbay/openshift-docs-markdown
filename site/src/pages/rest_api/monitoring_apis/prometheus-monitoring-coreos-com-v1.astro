      <h3 id="_specthanosgrpcservertlsconfig" class="group scroll-mt-20">.spec.thanos.grpcServerTlsConfig<a href="#_specthanosgrpcservertlsconfig" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
