      </TableHeader>
      <TableBody>
      <TableRow>
      <TableCell><code>action</code></TableCell>
      <TableCell><code>string</code></TableCell>
      <TableCell>action to perform based on the regex matching.<Fragment set:html={"<br>"} /><code>Uppercase</code> and <code>Lowercase</code> actions require Prometheus &gt;= v2.36.0. <code>DropEqual</code> and <code>KeepEqual</code> actions require Prometheus &gt;= v2.41.0.<Fragment set:html={"<br>"} />Default: "Replace"</TableCell>
