      </TableRow>
      </TableBody>
      </Table>
      <h3 id="_speccontainersstartupprobehttpget" class="group scroll-mt-20">.spec.containers[].startupProbe.httpGet<a href="#_speccontainersstartupprobehttpget" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
