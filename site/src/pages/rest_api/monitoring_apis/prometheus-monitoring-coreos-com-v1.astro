      <h3 id="_specvolumesprojectedsourcesconfigmap" class="group scroll-mt-20">.spec.volumes[].projected.sources[].configMap<a href="#_specvolumesprojectedsourcesconfigmap" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
