      </TableRow>
      </TableHeader>
      <TableBody>
      <TableRow>
      <TableCell><code>lastProbeTime</code></TableCell>
      <TableCell><code>string</code></TableCell>
      <TableCell>lastProbeTime is the time we probed the condition.</TableCell>
      </TableRow>
      <TableRow>
      <TableCell><code>lastTransitionTime</code></TableCell>
