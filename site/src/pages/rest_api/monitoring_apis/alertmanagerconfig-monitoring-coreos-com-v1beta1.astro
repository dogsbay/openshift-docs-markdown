      <h3 id="_specreceiversslackconfigsactions" class="group scroll-mt-20">.spec.receivers[].slackConfigs[].actions<a href="#_specreceiversslackconfigsactions" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
