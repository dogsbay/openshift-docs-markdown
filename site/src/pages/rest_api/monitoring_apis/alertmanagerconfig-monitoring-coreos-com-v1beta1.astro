      <h3 id="_specreceiversslackconfigsfields" class="group scroll-mt-20">.spec.receivers[].slackConfigs[].fields<a href="#_specreceiversslackconfigsfields" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
