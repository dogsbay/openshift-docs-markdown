      </TableRow>
      <TableRow>
      <TableCell><code>toParty</code></TableCell>
      <TableCell><code>string</code></TableCell>
      <TableCell>toParty defines the target department(s) to receive the notification. Can be a single department ID or multiple department IDs separated by '\</TableCell>
      </TableRow>
      <TableRow>
      <TableCell>'.</TableCell>
      <TableCell><code>toTag</code></TableCell>
      <TableCell><code>string</code></TableCell>
      </TableRow>
      <TableRow>
      <TableCell>toTag defines the target tag(s) to receive the notification. Can be a single tag ID or multiple tag IDs separated by '\</TableCell>
      <TableCell>'.</TableCell>
      <TableCell><code>toUser</code></TableCell>
      </TableRow>
      <TableRow>
      <TableCell><code>string</code></TableCell>
      <TableCell>toUser defines the target user(s) to receive the notification. Can be a single user ID or multiple user IDs separated by '\</TableCell>
      <TableCell>'.</TableCell>
      </TableRow>
