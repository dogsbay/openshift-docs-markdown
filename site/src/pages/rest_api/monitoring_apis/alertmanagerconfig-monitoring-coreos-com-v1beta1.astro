      <dd class="ml-6 text-muted-foreground"><p>RocketChatFieldConfig defines a field for RocketChat messages.</p></dd>
      <dt class="font-semibold">Type</dt>
      <dd class="ml-6 text-muted-foreground"><CodeBlock code={"`object`"} lang="plaintext" /></dd>
      </dl>
      <Table class="my-4">
      <TableHeader>
      <TableRow>
      <TableHead>Property</TableHead>
