      <TableCell><code>action</code></TableCell>
      <TableCell><code>string</code></TableCell>
      <TableCell>action to perform based on regex matching. Must be one of: 'Replace', 'Keep', 'Drop', 'HashMod', 'LabelMap', 'LabelDrop', or 'LabelKeep'. Default is: 'Replace'</TableCell>
      </TableRow>
      <TableRow>
