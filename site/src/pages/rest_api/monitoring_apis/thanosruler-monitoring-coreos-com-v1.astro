.projected.sources[].downwardAPI.items[].resourceFieldRef"},{"depth":3,"slug":"_specvolumesprojectedsourcespodcertificate","text":".spec.volumes[].projected.sources[].podCertificate"},{"depth":3,"slug":"_specvolumesprojectedsourcessecret","text":".spec.volumes[].projected.sources[].secret"},{"depth":3,"slug":"_specvolumesprojectedsourcessecretitems","text":".spec.volumes[].projected.sources[].secret.items"},{"depth":3,"slug":"_specvolumesprojectedsourcessecretitems","text":".spec.volumes[].projected.sources[].secret.items[]"},{"depth":3,"slug":"_specvolumesprojectedsourcesserviceaccounttoken","text":".spec.volumes[].projected.sources[].serviceAccountToken"},{"depth":3,"slug":"_specvolumesquobyte","text":".spec.volumes[].quobyte"},{"depth":3,"slug":"_specvolumesrbd","text":".spec.volumes[].rbd"},{"depth":3,"slug":"_specvolumesrbdsecretref","text":".spec.volumes[].rbd.secretRef"},{"depth":3,"slug":"_specvolumesscaleio","text":".spec.volumes[].scaleIO"},{"depth":3,"slug":"_specvolumesscaleiosecretref","text":".spec.volumes[].scaleIO.secretRef"},{"depth":3,"slug":"_specvolumessecret","text":".spec.volumes[].secret"},{"depth":3,"slug":"_specvolumessecretitems","text":".spec.volumes[].secret.items"},{"depth":3,"slug":"_specvolumessecretitems","text":".spec.volumes[].secret.items[]"},{"depth":3,"slug":"_specvolumesstorageos","text":".spec.volumes[].storageos"},{"depth":3,"slug":"_specvolumesstorageossecretref","text":".spec.volumes[].storageos.secretRef"},{"depth":3,"slug":"_specvolumesvspherevolume","text":".spec.volumes[].vsphereVolume"},{"depth":3,"slug":"_specweb","text":".spec.web"},{"depth":3,"slug":"_specwebhttpconfig","text":".spec.web.httpConfig"},{"depth":3,"slug":"_specwebhttpconfigheaders","text":".spec.web.httpConfig.headers"},{"depth":3,"slug":"_specwebtlsconfig","text":".spec.web.tlsConfig"},{"depth":3,"slug":"_specwebtlsconfigcert","text":".spec.web.tlsConfig.cert"},{"depth":3,"slug":"_specwebtlsconfigcertconfigmap","text":".spec.web.tlsConfig.cert.configMap"},{"depth":3,"slug":"_specwebtlsconfigcertsecret","text":".spec.web.tlsConfig.cert.secret"},{"depth":3,"slug":"_specwebtlsconfigclient_ca","text":".spec.web.tlsConfig.client_ca"},{"depth":3,"slug":"_specwebtlsconfigclient_caconfigmap","text":".spec.web.tlsConfig.client_ca.configMap"},{"depth":3,"slug":"_specwebtlsconfigclient_casecret","text":".spec.web.tlsConfig.client_ca.secret"},{"depth":3,"slug":"_specwebtlsconfigkeysecret","text":".spec.web.tlsConfig.keySecret"},{"depth":3,"slug":"_status","text":".status"},{"depth":3,"slug":"_statusconditions","text":".status.conditions"},{"depth":3,"slug":"_statusconditions","text":".status.conditions[]"},{"depth":2,"slug":"_api_endpoints","text":"API endpoints"},{"depth":3,"slug":"_apismonitoringcoreoscomv1thanosrulers","text":"/apis/monitoring.coreos.com/v1/thanosrulers"},{"depth":3,"slug":"_apismonitoringcoreoscomv1namespaces_namespace_thanosrulers","text":"/apis/monitoring.coreos.com/v1/namespaces/{{ namespace }}/thanosrulers"},{"depth":3,"slug":"_apismonitoringcoreoscomv1namespaces_namespace_thanosrulers_name","text":"/apis/monitoring.coreos.com/v1/namespaces/{{ namespace }}/thanosrulers/{{ name }}"},{"depth":3,"slug":"_apismonitoringcoreoscomv1namespaces_namespace_thanosrulers_name_status","text":"/apis/monitoring.coreos.com/v1/namespaces/{{ namespace }}/thanosrulers/{{ name }}/status"}];
