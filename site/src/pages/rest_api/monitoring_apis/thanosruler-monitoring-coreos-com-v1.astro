      <h3 id="_specstoragevolumeclaimtemplatestatus" class="group scroll-mt-20">.spec.storage.volumeClaimTemplate.status<a href="#_specstoragevolumeclaimtemplatestatus" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
