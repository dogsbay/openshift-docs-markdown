      <h3 id="_specalertrelabelconfigs" class="group scroll-mt-20">.spec.alertRelabelConfigs<a href="#_specalertrelabelconfigs" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
