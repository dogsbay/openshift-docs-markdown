      <h3 id="_specvolumesephemeralvolumeclaimtemplatemetadata" class="group scroll-mt-20">.spec.volumes[].ephemeral.volumeClaimTemplate.metadata<a href="#_specvolumesephemeralvolumeclaimtemplatemetadata" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
      <dl class="my-4 space-y-2">
