      <TableHead>Property</TableHead>
      <TableHead>Type</TableHead>
      <TableHead>Description</TableHead>
      </TableRow>
      </TableHeader>
      <TableBody>
      <TableRow>
      <TableCell><code>ca</code></TableCell>
      <TableCell><code>object</code></TableCell>
      <TableCell>ca defines the Certificate authority used when verifying server certificates.</TableCell>
      </TableRow>
      <TableRow>
      <TableCell><code>caFile</code></TableCell>
      <TableCell><code>string</code></TableCell>
      <TableCell>caFile defines the path to the CA cert in the Prometheus container to use for the targets.</TableCell>
      </TableRow>
      <TableRow>
      <TableCell><code>cert</code></TableCell>
      <TableCell><code>object</code></TableCell>
      <TableCell>cert defines the Client certificate to present when doing client-authentication.</TableCell>
      </TableRow>
      <TableRow>
      <TableCell><code>certFile</code></TableCell>
      <TableCell><code>string</code></TableCell>
      <TableCell>certFile defines the path to the client cert file in the Prometheus container for the targets.</TableCell>
      </TableRow>
      <TableRow>
      <TableCell><code>insecureSkipVerify</code></TableCell>
      <TableCell><code>boolean</code></TableCell>
