      <h3 id="_specaffinitypodantiaffinity" class="group scroll-mt-20">.spec.affinity.podAntiAffinity<a href="#_specaffinitypodantiaffinity" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
