      <h3 id="_specvolumesprojectedsourcespodcertificate" class="group scroll-mt-20">.spec.volumes[].projected.sources[].podCertificate<a href="#_specvolumesprojectedsourcespodcertificate" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
