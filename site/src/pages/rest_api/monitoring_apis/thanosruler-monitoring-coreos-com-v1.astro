      <h3 id="_specvolumesprojected" class="group scroll-mt-20">.spec.volumes[].projected<a href="#_specvolumesprojected" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
      <dl class="my-4 space-y-2">
      <dt class="font-semibold">Description</dt>
      <dd class="ml-6 text-muted-foreground"><p>projected items for all in one resources secrets, configmaps, and downward API</p></dd>
      <dt class="font-semibold">Type</dt>
      <dd class="ml-6 text-muted-foreground"><CodeBlock code={"`object`"} lang="plaintext" /></dd>
      </dl>
      <Table class="my-4">
      <TableHeader>
