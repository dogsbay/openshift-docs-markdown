      <TableRow>
      <TableCell><code>keyFile</code></TableCell>
      <TableCell><code>string</code></TableCell>
      <TableCell>keyFile defines the path to the client key file in the Prometheus container for the targets.</TableCell>
      </TableRow>
      <TableRow>
      <TableCell><code>keySecret</code></TableCell>
      <TableCell><code>object</code></TableCell>
      <TableCell>keySecret defines the Secret containing the client key file for the targets.</TableCell>
      </TableRow>
      <TableRow>
      <TableCell><code>maxVersion</code></TableCell>
      <TableCell><code>string</code></TableCell>
