      <TableCell><code>storage</code></TableCell>
      <TableCell><code>object</code></TableCell>
      <TableCell>storage details for configuring registry storage, e.g. S3 bucket coordinates.</TableCell>
      </TableRow>
      <TableRow>
      <TableCell><code>tolerations</code></TableCell>
      <TableCell><code>array</code></TableCell>
      <TableCell>tolerations defines the tolerations for the registry pod.</TableCell>
      </TableRow>
