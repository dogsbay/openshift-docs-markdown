      <h2 id="_api_endpoints" class="group scroll-mt-20">API endpoints<a href="#_api_endpoints" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h2>
      <p>The following API endpoints are available:</p>
      <ul>
      <li>
      <code>/apis/operator.openshift.io/v1/machineconfigurations</code>
      <ul>
      <li><code>DELETE</code>: delete collection of MachineConfiguration</li>
      <li><code>GET</code>: list objects of kind MachineConfiguration</li>
      <li><code>POST</code>: create a MachineConfiguration</li>
      </ul>
      </li>
      <li>
      <code>/apis/operator.openshift.io/v1/machineconfigurations/{"{"}name{"}"}</code>
      <ul>
      <li><code>DELETE</code>: delete a MachineConfiguration</li>
      <li><code>GET</code>: read the specified MachineConfiguration</li>
      <li><code>PATCH</code>: partially update the specified MachineConfiguration</li>
      <li><code>PUT</code>: replace the specified MachineConfiguration</li>
      </ul>
      </li>
      <li>
      <code>/apis/operator.openshift.io/v1/machineconfigurations/{"{"}name{"}"}/status</code>
      <ul>
      <li><code>GET</code>: read status of the specified MachineConfiguration</li>
      <li><code>PATCH</code>: partially update status of the specified MachineConfiguration</li>
      <li><code>PUT</code>: replace status of the specified MachineConfiguration</li>
      </ul>
      </li>
      </ul>
