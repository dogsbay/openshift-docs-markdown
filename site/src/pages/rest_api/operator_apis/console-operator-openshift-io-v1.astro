      <h3 id="_speccustomizationperspectivesvisibilityaccessreviewmissing" class="group scroll-mt-20">.spec.customization.perspectives[].visibility.accessReview.missing<a href="#_speccustomizationperspectivesvisibilityaccessreviewmissing" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
