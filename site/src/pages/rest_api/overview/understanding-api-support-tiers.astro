      <h1 id="understanding-api-support-tiers" class="group scroll-mt-20">Understanding API tiers<a href="#understanding-api-support-tiers" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h1>
      <Alert variant="info" class="my-4">
