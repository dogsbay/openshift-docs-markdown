      <h3 id="_specinstallspecdeploymentsspec" class="group scroll-mt-20">.spec.install.spec.deployments[].spec<a href="#_specinstallspecdeploymentsspec" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
