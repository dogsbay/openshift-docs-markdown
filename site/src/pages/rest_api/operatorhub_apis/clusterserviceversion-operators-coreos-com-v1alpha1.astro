      <h3 id="_specinstallspecdeploymentsspectemplatespecworkloadref" class="group scroll-mt-20">.spec.install.spec.deployments[].spec.template.spec.workloadRef<a href="#_specinstallspecdeploymentsspectemplatespecworkloadref" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
