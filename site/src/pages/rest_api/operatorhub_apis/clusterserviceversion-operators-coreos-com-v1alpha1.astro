      <h3 id="_specinstallspecdeploymentsspectemplatespecinitcontainersstartupprobehttpget" class="group scroll-mt-20">.spec.install.spec.deployments[].spec.template.spec.initContainers[].startupProbe.httpGet<a href="#_specinstallspecdeploymentsspectemplatespecinitcontainersstartupprobehttpget" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
      <dl class="my-4 space-y-2">
      <dt class="font-semibold">Description</dt>
      <dd class="ml-6 text-muted-foreground"><p>HTTPGet specifies an HTTP GET request to perform.</p></dd>
      <dt class="font-semibold">Type</dt>
      <dd class="ml-6 text-muted-foreground"><CodeBlock code={"`object`"} lang="plaintext" /></dd>
      <dt class="font-semibold">Required</dt>
      <dd class="ml-6 text-muted-foreground"><ul><li><code>port</code></li></ul></dd>
      </dl>
      <Table class="my-4">
      <TableHeader>
      <TableRow>
      <TableHead>Property</TableHead>
      <TableHead>Type</TableHead>
      <TableHead>Description</TableHead>
      </TableRow>
      </TableHeader>
      <TableBody>
      <TableRow>
      <TableCell><code>host</code></TableCell>
      <TableCell><code>string</code></TableCell>
      <TableCell>Host name to connect to, defaults to the pod IP. You probably want to set "Host" in httpHeaders instead.</TableCell>
      </TableRow>
      <TableRow>
