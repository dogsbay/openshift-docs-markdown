      <h3 id="_specinstallspecdeploymentsspectemplatespecvolumesprojectedsources" class="group scroll-mt-20">.spec.install.spec.deployments[].spec.template.spec.volumes[].projected.sources<a href="#_specinstallspecdeploymentsspectemplatespecvolumesprojectedsources" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
