      <h3 id="_specconfigaffinitypodaffinitypreferredduringschedulingignoredduringexecutionpodaffinityterm" class="group scroll-mt-20">.spec.config.affinity.podAffinity.preferredDuringSchedulingIgnoredDuringExecution[].podAffinityTerm<a href="#_specconfigaffinitypodaffinitypreferredduringschedulingignoredduringexecutionpodaffinityterm" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
      <dl class="my-4 space-y-2">
      <dt class="font-semibold">Description</dt>
      <dd class="ml-6 text-muted-foreground"><p>Required. A pod affinity term, associated with the corresponding weight.</p></dd>
      <dt class="font-semibold">Type</dt>
      <dd class="ml-6 text-muted-foreground"><CodeBlock code={"`object`"} lang="plaintext" /></dd>
      <dt class="font-semibold">Required</dt>
      <dd class="ml-6 text-muted-foreground"><ul><li><code>topologyKey</code></li></ul></dd>
