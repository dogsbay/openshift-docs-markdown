      <h3 id="_templatespecresourcesclaims" class="group scroll-mt-20">.template.spec.resources.claims[]<a href="#_templatespecresourcesclaims" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
