      <h3 id="_templatespecvolumesstorageos" class="group scroll-mt-20">.template.spec.volumes[].storageos<a href="#_templatespecvolumesstorageos" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
