      <dt class="font-semibold">Required</dt>
      <dd class="ml-6 text-muted-foreground">
      <ul>
      <li><code>gateway</code></li>
      <li><code>system</code></li>
      <li><code>secretRef</code></li>
      </ul>
      </dd>
      </dl>
      <Table class="my-4">
      <TableHeader>
      <TableRow>
      <TableHead>Property</TableHead>
