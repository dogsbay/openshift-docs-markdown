      <h3 id="_statusallocationdevicesresults" class="group scroll-mt-20">.status.allocation.devices.results<a href="#_statusallocationdevicesresults" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
