      <h3 id="_statusallocationdevicesconfig" class="group scroll-mt-20">.status.allocation.devices.config<a href="#_statusallocationdevicesconfig" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
