      <CodeBlock code={"apiVersion: rbac.authorization.k8s.io/v1\nkind: ClusterRoleBinding\nmetadata:\n annotations:\n   rbac.authorization.kubernetes.io/autoupdate: \"true\"\n name: <cluster_role>access-unauthenticated\nroleRef:\n apiGroup: rbac.authorization.k8s.io\n kind: ClusterRole\n name: <cluster_role>\nsubjects:\n - apiGroup: rbac.authorization.k8s.io\n   kind: Group\n   name: system:unauthenticated"} lang="yaml" />
      </li>
      <li>
