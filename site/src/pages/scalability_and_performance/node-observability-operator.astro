      <CodeBlock code={"cat <<EOF | oc apply -f -\napiVersion: operators.coreos.com/v1\nkind: OperatorGroup\nmetadata:\n  name: node-observability-operator\n  namespace: node-observability-operator\nspec:\n  targetNamespaces: []\nEOF"} lang="yaml" />
