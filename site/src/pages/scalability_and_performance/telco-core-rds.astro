      <TableCell>No</TableCell>
      </TableRow>
      <TableRow>
      <TableCell>Kdump enable</TableCell>
      <TableCell><code>kdump-worker.yaml</code></TableCell>
      <TableCell>Configures kdump crash reporting on worker nodes.</TableCell>
      <TableCell>No</TableCell>
      </TableRow>
      </TableBody>
      </Table>
      <h3 id="cluster-infrastructure-crs_telco-core" class="group scroll-mt-20">Cluster infrastructure reference CRs<a href="#cluster-infrastructure-crs_telco-core" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1">&para;</a></h3>
