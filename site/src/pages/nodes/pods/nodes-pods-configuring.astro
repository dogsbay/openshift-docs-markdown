      <CodeBlock code={"{\n    \"kind\": \"Pod\",\n    \"spec\": {\n        \"containers\": [\n            {\n                \"image\": \"openshift/hello-openshift\",\n                \"name\": \"hello-openshift\"\n            }\n        ]\n    },\n    \"apiVersion\": \"v1\",\n    \"metadata\": {\n        \"name\": \"iperf-slow\",\n        \"annotations\": {\n            \"kubernetes.io/ingress-bandwidth\": \"10M\",\n            \"kubernetes.io/egress-bandwidth\": \"10M\"\n        }\n    }\n}"} lang="json" title="Limited Pod object definition" />
      </li>
