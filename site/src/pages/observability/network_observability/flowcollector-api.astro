      <TableCell><code>address</code></TableCell>
      <TableCell><code>string</code></TableCell>
      <TableCell>Address of the Kafka server</TableCell>
      </TableRow>
      <TableRow>
      <TableCell><code>compression</code></TableCell>
      <TableCell><code>string</code></TableCell>
      <TableCell>Compression codec to use when producing messages to Kafka. Accepted values are: <code>none</code> (default), <code>gzip</code>, <code>snappy</code>, <code>lz4</code>, <code>zstd</code>.</TableCell>
      </TableRow>
