-osp-deploying-bare-metal-machines_installing-openstack-user","text":"Deploying a cluster with bare-metal machines"},{"depth":2,"slug":"installation-osp-creating-bootstrap-machine_installing-openstack-user","text":"Creating the bootstrap machine on RHOSP"},{"depth":2,"slug":"installation-osp-creating-control-plane_installing-openstack-user","text":"Creating the control plane machines on RHOSP"},{"depth":2,"slug":"cli-logging-in-kubeadmin_installing-openstack-user","text":"Logging in to the cluster by using the CLI"},{"depth":2,"slug":"installation-osp-deleting-bootstrap-resources_installing-openstack-user","text":"Deleting bootstrap resources from RHOSP"},{"depth":2,"slug":"installation-osp-creating-compute-machines_installing-openstack-user","text":"Creating compute machines on RHOSP"},{"depth":2,"slug":"installation-approve-csrs_installing-openstack-user","text":"Approving the certificate signing requests for your machines"},{"depth":2,"slug":"installation-osp-verifying-installation_installing-openstack-user","text":"Verifying a successful installation"},{"depth":2,"slug":"cluster-telemetry_installing-openstack-user","text":"Telemetry access for OpenShift Container Platform"}];
