pth":3,"slug":"infrastructure-moving-registry_post-install-cluster-tasks","text":"Moving the default registry"},{"depth":3,"slug":"infrastructure-moving-monitoring_post-install-cluster-tasks","text":"Moving the monitoring solution"},{"depth":2,"slug":"cluster-autoscaler-about_post-install-cluster-tasks","text":"The cluster autoscaler"},{"depth":3,"slug":"cluster-autoscaler-scale-down_post-install-cluster-tasks","text":"Automatic node removal"},{"depth":3,"slug":"cluster-autoscaler-limitations_post-install-cluster-tasks","text":"Limitations"},{"depth":3,"slug":"cluster-autoscaler-interaction_post-install-cluster-tasks","text":"Interaction with other scheduling features"},{"depth":3,"slug":"cluster-autoscaler-cr_post-install-cluster-tasks","text":"Cluster autoscaler resource definition"},{"depth":3,"slug":"ClusterAutoscaler-deploying_post-install-cluster-tasks","text":"Deploying a cluster autoscaler"},{"depth":2,"slug":"custer-tasks-applying-autoscaling_post-install-cluster-tasks","text":"Applying autoscaling to your cluster"},{"depth":2,"slug":"post-install-tp-tasks_post-install-cluster-tasks","text":"Enabling Technology Preview features using FeatureGates"},{"depth":3,"slug":"nodes-cluster-enabling-features-about_post-install-cluster-tasks","text":"Understanding feature gates"},{"depth":3,"slug":"nodes-cluster-enabling-features-console_post-install-cluster-tasks","text":"Enabling feature sets using the web console"},{"depth":3,"slug":"nodes-cluster-enabling-features-cli_post-install-cluster-tasks","text":"Enabling feature sets using the CLI"},{"depth":2,"slug":"post-install-etcd-tasks_post-install-cluster-tasks","text":"etcd tasks"},{"depth":3,"slug":"about-etcd_post-install-cluster-tasks","text":"etcd encryption"},{"depth":3,"slug":"etcd-encryption-types_post-install-cluster-tasks","text":"Supported encryption types"},{"depth":3,"slug":"enabling-etcd-encryption_post-install-cluster-tasks","text":"Enabling etcd encryption"},{"depth":3,"slug":"disabling-etcd-encrypti