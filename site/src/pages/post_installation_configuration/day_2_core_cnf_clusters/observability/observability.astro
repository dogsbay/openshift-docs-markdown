      <TableCell><code>sum by (node) (sum_over_time(kube_pod_container_resource_requests{"{"}resource="cpu"{"}"}[60m]))/sum by (node) (sum_over_time(kube_node_status_allocatable{"{"}resource="cpu"{"}"}[60m])) *100</code></TableCell>
      </TableRow>
      <TableRow>
      <TableCell>Overall cluster CPU % utilization</TableCell>
      <TableCell><code>sum by (managed_cluster) (sum_over_time(kube_pod_container_resource_requests{"{"}resource="memory"{"}"}[60m]))/sum by (managed_cluster) (sum_over_time(kube_node_status_allocatable{"{"}resource="cpu"{"}"}[60m])) *100</code></TableCell>
