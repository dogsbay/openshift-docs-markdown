# markdown/ and site/ are BOTH tracked, including site/dist — the
# built HTML is what GitHub Pages will publish, so it is a
# deliverable here rather than a build artefact.
#
# Only genuinely local state is ignored. node_modules is restorable
# from package-lock.json; .astro is Astro's own cache.
site/node_modules/
site/.astro/
node_modules/
